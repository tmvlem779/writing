# 브라우저 노출 가능
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 서버 전용
SUPABASE_SECRET_KEY=
# AI_PROVIDER=auto이면 UPSTAGE_API_KEY가 있을 때 Upstage를, 없으면 OpenAI를 사용합니다.
AI_PROVIDER=auto
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-mini4
# 미성년자 안전 검사를 위해 OpenAI Moderation 키는 Upstage 사용 시에도 필요합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SAFETY_IDENTIFIER_SALT=change-me

# 운영 설정
APP_ENV=development
MAX_TURNS_PER_SESSION=30
MAX_INPUT_CHARS=4000
MONTHLY_OPENAI_BUDGET_USD=6
DATA_RETENTION_DAYS=0
